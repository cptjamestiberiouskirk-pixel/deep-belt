# Normalize text files to LF in the Git index (w/crlf on Windows via core.autocrlf).
* text=auto

# PLAYBOOK.md and TESTING.md explicitly check that App.tsx stays w/crlf.
App.tsx text eol=crlf

# Files already checked out with LF in this repository stay LF cleanly.
LICENSE text eol=lf
SpriteRenderer.ts text eol=lf
design/asset_manifest.json text eol=lf
design/game_design_document.json text eol=lf
index.html text eol=lf
index.tsx text eol=lf
styles.css text eol=lf
tsconfig.json text eol=lf
vite-env.d.ts text eol=lf
vite.config.ts text eol=lf

# Binary game and font assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp3 binary
*.ogg binary
*.wav binary
*.woff2 binary
